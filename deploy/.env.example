# StockIQ NAS Docker Environment
# Copy this file to .env and fill in your values

# --- Database ---
POSTGRES_USER=stockiq
POSTGRES_PASSWORD=stockiq_secure_pw
POSTGRES_DB=stockiq
DATABASE_URL=postgresql://stockiq:stockiq_secure_pw@stockiq-db:5432/stockiq

# --- NAS Network ---
# NAS local IP (used for NEXT_PUBLIC_API_URL build arg)
NAS_IP=172.30.1.34

# --- Kiwoom REST API ---
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_BASE_URL=https://openapi.koreainvestment.com:9443
KIWOOM_ACCOUNT=

# --- AI / LLM ---
OPENROUTER_API_KEY=
DART_API_KEY=
FRED_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
